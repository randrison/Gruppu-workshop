{
  "rewrites": [
    { "source": "/blog", "destination": "https://gruppu-plataforma.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://gruppu-plataforma.vercel.app/blog/:path*" },
    { "source": "/login", "destination": "https://gruppu-plataforma.vercel.app/login" },
    { "source": "/login/", "destination": "https://gruppu-plataforma.vercel.app/login" },
    { "source": "/app", "destination": "https://gruppu-plataforma.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://gruppu-plataforma.vercel.app/app/:path*" },
    { "source": "/captura", "destination": "https://gruppu-plataforma.vercel.app/captura" },
    { "source": "/captura/", "destination": "https://gruppu-plataforma.vercel.app/captura" },
    { "source": "/politica-de-privacidade", "destination": "https://gruppu-plataforma.vercel.app/politica-de-privacidade" },
    { "source": "/politica-de-privacidade/", "destination": "https://gruppu-plataforma.vercel.app/politica-de-privacidade" },
    { "source": "/api/:path*", "destination": "https://gruppu-plataforma.vercel.app/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://gruppu-plataforma.vercel.app/_next/:path*" },
    { "source": "/manifest.webmanifest", "destination": "https://gruppu-plataforma.vercel.app/manifest.webmanifest" },
    { "source": "/sw.js", "destination": "https://gruppu-plataforma.vercel.app/sw.js" },
    { "source": "/icons/:path*", "destination": "https://gruppu-plataforma.vercel.app/icons/:path*" }
  ]
}
